// REQUIRED SHADER DEFINES ---------------------------------------------------------------

// PROBE_NUM_TEXELS must be passed in as a define at shader compilation time.
// This define specifies the number of texels of a single dimension of a probe.
// #define PROBE_NUM_TEXELS 6   // probe irradiance is 6x6 texels
// #define PROBE_NUM_TEXELS 14  // probe distance data is 14x14 texels

// PROBE_DATA_REGISTER must be passed in as a define at shader compilation time.
// This define specifies what register the DDGIVolume's probe data is bound to (matching the root signature).
// #define PROBE_DATA_REGISTER u2

// RAYS_PER_PROBE must be passed in, as a define at shader compilation time, *when using shared memory*.
// This define specifies the number of rays that are cast per probe and will determine how data
// is cooperatively loaded, computed, and stored in shared memory.
// #define RAYS_PER_PROBE 144

// For example usage, see Harness.cpp::CompileVolumeShaders() in the Test Harness.

// --------------------------------------------------------------------------------------

#include "/Engine/Private/Common.ush"
#include "ProbeCommon.ush"

#define PROBE_NUM_TEXELS_WITH_BORDER (PROBE_NUM_TEXELS + 2)

int ProbeIndexStart;
int ProbeIndexCount;
int PartialUpdateISV;           // 1: forced infinite-scrolling update, only probes that wrapped are blended
int VariabilityMeasureOnly;     // 1: write variability only, leave irradiance and borders untouched

// Probe ray radiance and hit distance
RWTexture2D<float4> DDGIVolumeRayDataUAV;

// Probe irradiance or filtered distance
RWTexture2D<float4> DDGIVolumeProbeDataUAV;

// Probe states
Texture2D<uint>     DDGIVolumeProbeStatesTexture;

// Infinite scrolling "space" parity per probe (always bound; only read for scrolling volumes)
RWTexture2D<uint>   DDGIProbeScrollSpace;

#if RTXGI_DDGI_BLEND_RADIANCE
RWTexture2D<float4> DDGIVolumeProbeVariabilityUAV;
#endif

#if RTXGI_DDGI_SHARED_MEMORY
#if RTXGI_DDGI_BLEND_RADIANCE
groupshared float3 RayRadiance[RAYS_PER_PROBE];
#endif
groupshared float  RayDistance[RAYS_PER_PROBE];
groupshared float3 RayDirection[RAYS_PER_PROBE];
#endif

float3 DDGILoadProbeRayRadiance(int2 rayTexCoord)
{
    float4 rayData = DDGIVolumeRayDataUAV[rayTexCoord];
    if (DDGIVolume.probeRayDataFormat != 0)
    {
        return rayData.rgb;
    }
    return RTXGIUintToFloat3(asuint(rayData.r));
}

float DDGILoadProbeRayDistance(int2 rayTexCoord)
{
    float4 rayData = DDGIVolumeRayDataUAV[rayTexCoord];
    return (DDGIVolume.probeRayDataFormat != 0) ? rayData.a : rayData.g;
}

#if RTXGI_DDGI_BLEND_RADIANCE
void DDGIWriteProbeVariability(uint2 variabilityCoords, float coefficientOfVariation, float weight)
{
    if (DDGIVolume.probeVariabilityEnabled != 0)
    {
        DDGIVolumeProbeVariabilityUAV[variabilityCoords] = float4(coefficientOfVariation, weight, 0.f, 0.f);
    }
}
#endif

void DDGIUpdateBorderTexel(uint2 probeBaseTexel, uint2 groupThreadID)
{
    const uint numTexels = PROBE_NUM_TEXELS_WITH_BORDER;
    const uint numInteriorTexels = PROBE_NUM_TEXELS;

    bool isCornerTexel = (groupThreadID.x == 0 || groupThreadID.x == (numTexels - 1)) && (groupThreadID.y == 0 || groupThreadID.y == (numTexels - 1));
    bool isRowTexel = (groupThreadID.x > 0 && groupThreadID.x < (numTexels - 1));

    uint2 copyCoordinates = probeBaseTexel;
    if (isCornerTexel)
    {
        copyCoordinates.x += (groupThreadID.x > 0) ? 1 : numInteriorTexels;
        copyCoordinates.y += (groupThreadID.y > 0) ? 1 : numInteriorTexels;
    }
    else if (isRowTexel)
    {
        copyCoordinates.x += (numTexels - 1) - groupThreadID.x;
        copyCoordinates.y += (groupThreadID.y > 0) ? (groupThreadID.y - 1) : (groupThreadID.y + 1);
    }
    else // Column texel
    {
        copyCoordinates.x += (groupThreadID.x > 0) ? (groupThreadID.x - 1) : (groupThreadID.x + 1);
        copyCoordinates.y += (numTexels - 1) - groupThreadID.y;
    }

#if RTXGI_DDGI_BLEND_RADIANCE && RTXGI_DDGI_DEBUG_BORDER_COPY_INDEXING
    DDGIVolumeProbeDataUAV[probeBaseTexel + groupThreadID] = float4(probeBaseTexel + groupThreadID, copyCoordinates);
    return;
#endif

    DDGIVolumeProbeDataUAV[probeBaseTexel + groupThreadID] = DDGIVolumeProbeDataUAV[copyCoordinates];
}

[numthreads(PROBE_NUM_TEXELS_WITH_BORDER, PROBE_NUM_TEXELS_WITH_BORDER, 1)]
void DDGIProbeBlendingCS(uint3 DispatchThreadID : SV_DispatchThreadID, uint3 GroupThreadID : SV_GroupThreadID, uint GroupIndex : SV_GroupIndex)
{
    const int3 probeGridCounts = DDGIVolume.probeGridCounts;
    const int numProbes = probeGridCounts.x * probeGridCounts.y * probeGridCounts.z;

    int probeIndex = DDGIGetProbeIndex(DispatchThreadID.xy, probeGridCounts, PROBE_NUM_TEXELS_WITH_BORDER);
    if (probeIndex < 0 || probeIndex >= numProbes)
    {
        return;
    }

    // Scroll offsets are zero for non-scrolling volumes, where the storage remap is an index
    int storageProbeIndex = DDGIGetProbeIndexOffset(probeIndex, probeGridCounts, DDGIVolume.probeScrollOffsets);
    int2 texelPosition = DDGIGetProbeTexelPosition(storageProbeIndex, probeGridCounts);

    // Infinite scrolling probe volumes detect probes that wrapped around the volume since their last blend.
    const bool bScrolling = (DDGIVolume.volumeMovementType != 0);
    uint3 probeSpace = uint3(0, 0, 0);
    bool bScrolledProbe = false;
    if (bScrolling)
    {
        uint packedPrevProbeSpace = DDGIProbeScrollSpace[texelPosition].x;
        uint3 prevProbeSpace = uint3(packedPrevProbeSpace & 0x01, (packedPrevProbeSpace & 0x02) >> 1, (packedPrevProbeSpace & 0x04) >> 2);

        int3 probeGridCoord = DDGIGetProbeCoords(probeIndex, probeGridCounts);
        probeSpace = uint3((probeGridCoord + DDGIVolume.probeScrollOffsets) / probeGridCounts) % 2;
        bScrolledProbe = any(probeSpace != prevProbeSpace);
    }

    if (PartialUpdateISV != 0)
    {
        // Forced scrolling update: only the probes that wrapped were traced
        if (!bScrolledProbe)
        {
            return;
        }
    }
    else
    {
        // Handle round robin updating. If this probe is outside of the window for updating, early out.
        int probeRRIndex = (probeIndex < ProbeIndexStart) ? probeIndex + numProbes : probeIndex;
        if (probeRRIndex >= ProbeIndexStart + ProbeIndexCount)
        {
            return;
        }
    }

    const bool isBorderTexel = (GroupThreadID.x == 0 || GroupThreadID.x == (PROBE_NUM_TEXELS + 1)) || (GroupThreadID.y == 0 || GroupThreadID.y == (PROBE_NUM_TEXELS + 1));

    // Inactive probes only trace fixed rays... so there's nothing to blend
    int probeState = DDGIVolumeProbeStatesTexture[texelPosition];
    if (probeState == PROBE_STATE_INACTIVE)
    {
#if RTXGI_DDGI_BLEND_RADIANCE
        if (!isBorderTexel)
        {
			// The nv sdk actually has a bug here
			// The sdk writes this at the bordered cooridinate, but the probe variability atlas has no "defined" borders
            uint2 inactiveVariabilityCoords = DDGIGetThreadBaseCoords(storageProbeIndex, probeGridCounts, PROBE_NUM_TEXELS) + (GroupThreadID.xy - uint2(1, 1));
            DDGIWriteProbeVariability(inactiveVariabilityCoords, 0.f, 0.f);
        }
#endif
        return;
    }

#if RTXGI_DDGI_SHARED_MEMORY
    {
        int totalIterations = int(ceil(float(RAYS_PER_PROBE) / float(PROBE_NUM_TEXELS_WITH_BORDER * PROBE_NUM_TEXELS_WITH_BORDER)));
        for (int iteration = 0; iteration < totalIterations; iteration++)
        {
            int loadRayIndex = (int(GroupIndex) * totalIterations) + iteration;
            if (loadRayIndex >= RAYS_PER_PROBE) break;

            int2 loadRayTexCoord = int2(loadRayIndex, probeIndex);
        #if RTXGI_DDGI_BLEND_RADIANCE
            RayRadiance[loadRayIndex] = DDGILoadProbeRayRadiance(loadRayTexCoord);
        #endif
            RayDistance[loadRayIndex] = DDGILoadProbeRayDistance(loadRayTexCoord);
            RayDirection[loadRayIndex] = DDGIGetProbeRayDirection(loadRayIndex, DDGIVolume.numRaysPerProbe, DDGIVolume.probeRayRotationTransform);
        }
    }

    // Wait for all threads in the group to finish shared memory operations
    GroupMemoryBarrierWithGroupSync();
#endif // RTXGI_DDGI_SHARED_MEMORY

    // Base texel of this probe's block in the atlas
    uint2 probeBaseTexel = DDGIGetThreadBaseCoords(storageProbeIndex, probeGridCounts, PROBE_NUM_TEXELS_WITH_BORDER);

    // --- Border threads --------------------------------------------
    if (isBorderTexel)
    {
        if (VariabilityMeasureOnly != 0)
        {
            return;
        }

        // Wait for the interior threads of this group to finish writing
        AllMemoryBarrierWithGroupSync();

        DDGIUpdateBorderTexel(probeBaseTexel, GroupThreadID.xy);
        return;
    }

    int2 interiorCoords = int2(GroupThreadID.xy) - int2(1, 1);
    uint2 outputCoords = probeBaseTexel + GroupThreadID.xy;
#if RTXGI_DDGI_BLEND_RADIANCE
    uint2 variabilityCoords = DDGIGetThreadBaseCoords(storageProbeIndex, probeGridCounts, PROBE_NUM_TEXELS) + uint2(interiorCoords);
#endif

#if RTXGI_DDGI_BLEND_RADIANCE && RTXGI_DDGI_DEBUG_PROBE_INDEXING
    // Visualize probe index
    if (DDGIVolume.probeIrradianceFormat != 0)
    {
        DDGIVolumeProbeDataUAV[outputCoords] = float4(probeIndex, 0, 0, 1);
    }
    return;
#endif

    // Get the probe ray direction associated with this texel
    float2 probeOctantUV = DDGIGetNormalizedOctahedralCoordinates(interiorCoords, PROBE_NUM_TEXELS);
    float3 probeRayDirection = DDGIGetOctahedralDirection(probeOctantUV);

#if RTXGI_DDGI_BLEND_RADIANCE && RTXGI_DDGI_DEBUG_OCTAHEDRAL_INDEXING
    if (DDGIVolume.probeIrradianceFormat != 0)
    {
        float4 debugResult = float4(0.f, 0.f, 0.f, 0.f);
        if (all(abs(probeOctantUV) <= 1.f))
        {
            float3 probeDirection = (abs(probeRayDirection) >= 0.001f) * sign(probeRayDirection);    // Robustness for when the octant is not a power of 2.
            debugResult = float4((probeDirection * 0.5f) + 0.5f, 1.f);
        }
        DDGIVolumeProbeDataUAV[outputCoords] = debugResult;
    }
    return;
#endif

    // Fixed rays feed relocation/classification only  and would bias the blend
    int rayIndex = RTXGI_DDGI_NUM_FIXED_RAYS;

#if RTXGI_DDGI_BLEND_RADIANCE
    // Backface hits are ignored when blending radiance. If random-ray backface threshold > blended
    // rays hit backfaces, the probe is probably inside geometry... so we don't blend anything 
	
    uint backfaces = 0;
    uint maxBackfaces = uint(float(DDGIVolume.numRaysPerProbe - rayIndex) * DDGIVolume.probeRandomRayBackfaceThreshold);
#endif

    // Blend radiance or distance values from each ray to compute irradiance or filtered distance
    float4 result = float4(0.f, 0.f, 0.f, 0.f);
    for ( ; rayIndex < DDGIVolume.numRaysPerProbe; rayIndex++)
    {
    #if RTXGI_DDGI_SHARED_MEMORY
        float3 rayDirection = RayDirection[rayIndex];
    #else
        float3 rayDirection = DDGIGetProbeRayDirection(rayIndex, DDGIVolume.numRaysPerProbe, DDGIVolume.probeRayRotationTransform);
    #endif

        // Weight is based on the cosine of the angle between the ray direction and the direction of the probe octant's texel
        float weight = max(0.f, dot(probeRayDirection, rayDirection));

    #if !RTXGI_DDGI_SHARED_MEMORY
        int2 probeRayIndex = int2(rayIndex, probeIndex);
    #endif

    #if RTXGI_DDGI_BLEND_RADIANCE
        #if RTXGI_DDGI_SHARED_MEMORY
            float3 probeRayRadiance = RayRadiance[rayIndex];
            float  probeRayDistance = RayDistance[rayIndex];
        #else
            float3 probeRayRadiance = DDGILoadProbeRayRadiance(probeRayIndex);
            float  probeRayDistance = DDGILoadProbeRayDistance(probeRayIndex);
        #endif

        // Backface hit, don't blend this sample
        if (probeRayDistance < 0.f)
        {
            backfaces++;
            if (backfaces >= maxBackfaces)
            {
                // rejected probes should be kept out of the variability average computation
                DDGIWriteProbeVariability(variabilityCoords, 0.f, 0.f);
                
				return;
            }
            continue;
        }

        // Blend the ray's radiance
        result += float4(probeRayRadiance * weight, weight);

    #else // !RTXGI_DDGI_BLEND_RADIANCE

        // Initialize the probe hit distance to three quarters of the distance of the grid cell diagonal
        float probeMaxRayDistance = length(DDGIVolume.probeGridSpacing) * 1.5f;

        // Increase or decrease the filtered distance value's "sharpness"
        weight = pow(weight, DDGIVolume.probeDistanceExponent);

        // HitT is negative on backface hits for the probe relocation, take the absolute value
        #if RTXGI_DDGI_SHARED_MEMORY
            float probeRayDistance = min(abs(RayDistance[rayIndex]), probeMaxRayDistance);
        #else
            float probeRayDistance = min(abs(DDGILoadProbeRayDistance(probeRayIndex)), probeMaxRayDistance);
        #endif

        // Filter the ray distance
        result += float4(probeRayDistance * weight, (probeRayDistance * probeRayDistance) * weight, 0.f, weight);
    #endif
    }

    // Normalize the blended irradiance (or filtered distance), if the combined weight is not close to zero.
    // To match the Monte Carlo Estimator for Irradiance, we should divide by N. Instead, we are dividing by
    // sum(cos(theta)) (the sum of the weights) to reduce variance, which needs a factor of 1/2. 
	
	//Distance is divided by 2 as well to avoid branching, so distance fetches multiply by 2.
    float epsilon = float(DDGIVolume.numRaysPerProbe - RTXGI_DDGI_NUM_FIXED_RAYS) * 1e-9f;
    result.rgb *= 1.f / (2.f * max(result.a, epsilon));
    result.a = 1.f;

    // Stored value (irradiance or filtered distance)
    float3 probeIrradianceMean = DDGIVolumeProbeDataUAV[outputCoords].rgb;

    float hysteresis = DDGIVolume.probeHysteresis;

    // measure zero variability and never wake the converged volume.
    if (dot(probeIrradianceMean, probeIrradianceMean) == 0 && VariabilityMeasureOnly == 0)
    {
        hysteresis = 0.f;
    }

    if (bScrolledProbe)
    {
        hysteresis = 0.f;
    }

#if RTXGI_DDGI_BLEND_RADIANCE
    // Tone-mapping gamma adjustment
    result.rgb = pow(result.rgb, DDGIVolume.probeInverseIrradianceEncodingGamma);

    // Difference between the current irradiance and the cached irradiance vaue of a probe
    float3 delta = (result.rgb - probeIrradianceMean.rgb);

    // Current irradiance (before interp) used by Probe Variability
    float3 irradianceSample = result.rgb;

    if (!bScrolledProbe)
    {
        if (RTXGIMaxComponent(probeIrradianceMean.rgb - result.rgb) > DDGIVolume.probeChangeThreshold)
        {
            // Lower the hysteresis when a large lighting change is detected
            hysteresis = max(0.f, hysteresis - 0.75f);
        }

		// Clamp probe update in case there is large brightness change delta.
        if (RTXGILinearRGBToLuminance(delta) > DDGIVolume.probeBrightnessThreshold)
        {
            delta *= 0.25f;
        }
    }

    // Interpolate the new blended irradiance with the existing irradiance in the probe.
    // A high hysteresis value emphasizes the existing probe irradiance.
    //
    // When using lower bit depth formats for irradiance, the difference between lerped values
    // may be smaller than what the texture format can represent. This can stop progress towards
    // the target value when going from high to low values. When darkening, step at least the minimum
    // value the texture format can represent to ensure the target value is reached. The threshold value
    // for 10-bit/channel formats is always used (even for float formats) to speed up light to dark convergence.
    static const float c_threshold = 1.f / 1024.f;
    float3 lerpDelta = (1.f - hysteresis) * delta;
    if (RTXGIMaxComponent(result.rgb) < RTXGIMaxComponent(probeIrradianceMean.rgb))
    {
        lerpDelta = min(max(c_threshold, abs(lerpDelta)), abs(delta)) * sign(lerpDelta);
    }
    result = float4(probeIrradianceMean.rgb + lerpDelta, 1.f);

    // Probe variability efficient of variation of this texel's irradiance
    if (DDGIVolume.probeVariabilityEnabled != 0)
    {
        float3 irradianceMean = result.rgb;
        float3 irradianceSigma2 = (irradianceSample - probeIrradianceMean) * (irradianceSample - irradianceMean);
        float  luminanceSigma2 = RTXGILinearRGBToLuminance(irradianceSigma2);
        float  luminanceMean = RTXGILinearRGBToLuminance(irradianceMean);
        float  coefficientOfVariation = (luminanceMean <= c_threshold) ? 0.f : sqrt(max(luminanceSigma2, 0.f)) / luminanceMean;

        DDGIWriteProbeVariability(variabilityCoords, coefficientOfVariation, 1.f);
    }

    // Converged volumes are only measured so leave the probe irradiance untouched
    if (VariabilityMeasureOnly != 0)
    {
        return;
    }
#else
    // Interpolate the new filtered distance with the existing filtered distance in the probe.
    // A high hysteresis value emphasizes the existing probe filtered distance.
    result = float4(lerp(result.rg, probeIrradianceMean.rg, hysteresis), 0.f, 1.f);

    if (bScrolling && all(GroupThreadID.xy == uint2(1, 1)))
    {
        uint probeSpacePacked = probeSpace.x;
        probeSpacePacked |= probeSpace.y << 1;
        probeSpacePacked |= probeSpace.z << 2;
        DDGIProbeScrollSpace[texelPosition] = probeSpacePacked;
    }
#endif

    DDGIVolumeProbeDataUAV[outputCoords] = result;
}
