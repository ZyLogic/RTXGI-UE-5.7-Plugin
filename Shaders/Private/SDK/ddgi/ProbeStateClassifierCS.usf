#include "/Engine/Private/Common.ush"
#include "ProbeCommon.ush"

int ProbeIndexStart;
int ProbeIndexCount;
int ClassificationLegacy;
int ClassificationMeasureOnly;

// Probe ray radiance and hit distance
RWTexture2D<float4> DDGIVolumeRayDataUAV;

// Probe states
RWTexture2D<uint> DDGIVolumeProbeStatesUAV;

RWTexture2D<float4> DDGIVolumeProbeVariabilityUAV;

#define DDGI_CLASSIFICATION_FLIP_MARKER 65000.f

float DDGILoadProbeRayDistanceForClassification(int2 rayTexCoord)
{
    float4 rayData = DDGIVolumeRayDataUAV[rayTexCoord];
    return (DDGIVolume.probeRayDataFormat != 0) ? rayData.a : rayData.g;
}

uint DDGIClassifyProbeLegacy(int probeIndex, int numRays)
{
    // Compute the bounds used to check for surrounding geometry
    float3 geometryBounds = DDGIVolume.probeGridSpacing;

    // Conservatively increase the geometry search area
    geometryBounds *= 2.f;

    if (DDGIVolume.probeRelocationEnabled != 0)
    {
        // A conservative bound that assumes the maximum offset value for this probe
        geometryBounds *= 1.45f;
    }

    float closestFrontfaceDistance = 1e27f;
    int   backfaceCount = 0;

    // Iterate over the rays cast for this probe
    for (int rayIndex = 0; rayIndex < numRays; rayIndex++)
    {
        float hitDistance = DDGILoadProbeRayDistanceForClassification(int2(rayIndex, probeIndex));

        // Don't include backface hit distances
        if (hitDistance < 0.f)
        {
            backfaceCount++;
            continue;
        }

        // Store the closest front face hit distance
        closestFrontfaceDistance = min(closestFrontfaceDistance, hitDistance);
    }

    // If this probe is near geometry, wake it up if the backface percentage is below the threshold
    if (all(closestFrontfaceDistance <= geometryBounds) && (float(backfaceCount) / numRays < DDGIVolume.probeFixedRayBackfaceThreshold))
    {
        return PROBE_STATE_ACTIVE;
    }
    return PROBE_STATE_INACTIVE;
}

uint DDGIClassifyProbe(int probeIndex, int numRays)
{
    float hitDistances[RTXGI_DDGI_NUM_FIXED_RAYS];
    int backfaceCount = 0;

    // Load the hit distances and count the number of backface hits
    for (int rayIndex = 0; rayIndex < numRays; rayIndex++)
    {
        hitDistances[rayIndex] = DDGILoadProbeRayDistanceForClassification(int2(rayIndex, probeIndex));
        backfaceCount += (hitDistances[rayIndex] < 0.f) ? 1 : 0;
    }

    // Early out, because the probe is probably inside geom
    if ((float(backfaceCount) / float(numRays)) > DDGIVolume.probeFixedRayBackfaceThreshold)
    {
        return PROBE_STATE_INACTIVE;
    }

    // Determine if there is nearby geometry in the probe's voxel
    for (int rayIndex2 = 0; rayIndex2 < numRays; rayIndex2++)
    {
        // Skip backface hits
        if (hitDistances[rayIndex2] < 0.f) continue;

        // Dixed rays are unrotated, so the dir should be expressed in the ddgi volume's grid space
        float3 direction = DDGIGetProbeRayDirection(rayIndex2, DDGIVolume.numRaysPerProbe, DDGIVolume.probeRayRotationTransform);
        direction = RTXGIQuaternionRotate(direction, RTXGIQuaternionConjugate(DDGIVolume.rotation));

        // taken from the sdk
        float3 distances = DDGIVolume.probeGridSpacing / max(abs(direction), float3(0.000001f, 0.000001f, 0.000001f));

        // distance to the closest plane intersect
        float maxDistance = min(distances.x, min(distances.y, distances.z));

        // If hit distance < closest plane intersect, the probe should be active
        if (hitDistances[rayIndex2] <= maxDistance)
        {
            return PROBE_STATE_ACTIVE;
        }
    }

    return PROBE_STATE_INACTIVE;
}

[numthreads(8, 4, 1)]
void DDGIProbeStateClassifierCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    // Compute the probe index for this thread 
    int probeIndex = DDGIGetProbeIndex(DispatchThreadID.xy, DDGIVolume.probeGridCounts);

    // Early out if the thread maps past the number of probes
    int numProbes = DDGIVolume.probeGridCounts.x * DDGIVolume.probeGridCounts.y * DDGIVolume.probeGridCounts.z;
    if (probeIndex >= numProbes)
    {
        return;
    }

    // Handle round robin updating.
    // If probe update did not happen within the update window, early out.
    {
        int probeRRIndex = (probeIndex < ProbeIndexStart) ? probeIndex + numProbes : probeIndex;
        if (probeRRIndex >= ProbeIndexStart + ProbeIndexCount)
            return;
    }

    // Scroll offsets are zero for non-scrolling volumes
    int storageProbeIndex = DDGIGetProbeIndexOffset(probeIndex, DDGIVolume.probeGridCounts, DDGIVolume.probeScrollOffsets);
    uint2 offsetTexelPosition = DDGIGetProbeTexelPosition(storageProbeIndex, DDGIVolume.probeGridCounts);

    // Get the number of ray samples to inspect
    int numRays = min(DDGIVolume.numRaysPerProbe, RTXGI_DDGI_NUM_FIXED_RAYS);

    uint newState = (ClassificationLegacy != 0) ? DDGIClassifyProbeLegacy(probeIndex, numRays) : DDGIClassifyProbe(probeIndex, numRays);

    if (ClassificationMeasureOnly != 0)
    {
        uint previousState = DDGIVolumeProbeStatesUAV[offsetTexelPosition];
        if (newState != previousState && DDGIVolume.probeVariabilityEnabled != 0)
        {
            // Mark every interior irradiance texel of the probe
            uint2 variabilityBase = DDGIGetThreadBaseCoords(storageProbeIndex, DDGIVolume.probeGridCounts, DDGIVolume.probeNumIrradianceTexels);
            for (int texelY = 0; texelY < DDGIVolume.probeNumIrradianceTexels; texelY++)
            {
                for (int texelX = 0; texelX < DDGIVolume.probeNumIrradianceTexels; texelX++)
                {
                    DDGIVolumeProbeVariabilityUAV[variabilityBase + uint2(texelX, texelY)] = float4(DDGI_CLASSIFICATION_FLIP_MARKER, 1.f, 0.f, 0.f);
                }
            }
        }
        return;
    }

    DDGIVolumeProbeStatesUAV[offsetTexelPosition] = newState;
}

[numthreads(8, 4, 1)]
void DDGIProbeStateActivateAllCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    DDGIVolumeProbeStatesUAV[DispatchThreadID.xy] = PROBE_STATE_ACTIVE;
}
